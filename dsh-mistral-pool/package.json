{
  "name": "dsh-mistral-pool",
  "description": "Mistral Vibe 一级供应商与多 Key 池插件：内置可编辑模型目录、支持 ACP（vibe-acp）与直连 HTTP 代理一键切换、按优先级与权重调度轮换，无需手改 API 密钥与地址。",
  "version": "0.5.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "mistral",
    "vibe",
    "acp",
    "llm-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lili-luo/dsh-plugin-bundle.git",
    "directory": "dsh-mistral-pool"
  },
  "homepage": "https://github.com/lili-luo/dsh-plugin-bundle/tree/main/dsh-mistral-pool#readme",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "icon": "./icon.svg"
}
